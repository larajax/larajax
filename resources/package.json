{
    "name": "larajax",
    "version": "1.0.0",
    "description": "Laravel implementation of the October AJAX server logic.",
    "homepage": "https://github.com/larajax/larajax#readme",
    "main": "resources/src/index.js",
    "devDependencies": {
        "vite": "^4.5.14"
    },
    "scripts": {
        "dev:framework": "vite build --mode development --config vite.framework.config.js",
        "dev:bundle": "vite build --mode development --config vite.bundle.config.js",
        "build:framework": "vite build --mode production --config vite.framework.config.js",
        "build:bundle": "vite build --mode production --config vite.bundle.config.js",
        "dev": "npm run dev:framework && npm run dev:bundle",
        "build": "npm run build:framework && npm run build:bundle",
        "pub": "npm run dev && npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/larajax/larajax.git"
    },
    "keywords": [
        "larajax",
        "laravel ajax",
        "ajax",
        "framework"
    ],
    "bugs": {
        "url": "https://github.com/larajax/larajax/issues"
    }
}
